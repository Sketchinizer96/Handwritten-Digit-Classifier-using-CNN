#Requires -Version 5.1
<#
.SYNOPSIS
    Scans all drives/folders/files on a Windows Server for clear-text passwords and secrets.

.DESCRIPTION
    One thread walks the drives (explicit stack, no recursion, junctions skipped) and feeds file
    paths into a bounded BlockingCollection. A pool of worker runspaces consumes the queue,
    pre-filters every line with keyword gates, then runs the regex patterns. Each worker keeps
    its own results and the main thread merges them at the end (no locks on the hot path).
    Reports: CSV + HTML + stats JSON, plus a running ScanHistory.csv. Secrets are masked by default.

.PARAMETER ConfigPath
    Path to the JSON config. Defaults to scanner-config.json next to this script.

.PARAMETER NoMask
    Show actual secret values in the report (overrides config). Use with care.

.EXAMPLE
    .\PasswordScanner.ps1
    .\PasswordScanner.ps1 -ConfigPath D:\Tools\my-config.json
#>
[CmdletBinding()]
param(
    [string]$ConfigPath = (Join-Path $PSScriptRoot 'scanner-config.json'),
    [switch]$NoMask
)

$ErrorActionPreference = 'Stop'
$scriptStart = Get-Date

# ---------------------------------------------------------------- config
if (-not (Test-Path -LiteralPath $ConfigPath)) {
    throw "Config file not found: $ConfigPath"
}
$cfg = Get-Content -LiteralPath $ConfigPath -Raw | ConvertFrom-Json

function Get-Cfg($name, $default) {
    if ($null -ne $cfg.PSObject.Properties[$name] -and $null -ne $cfg.$name) { return $cfg.$name }
    return $default
}

function New-CIHashSet([string[]]$Items) {
    $set = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
    foreach ($i in $Items) { if ($i) { [void]$set.Add($i) } }
    return , $set
}

$excludeDrives    = @(Get-Cfg 'ExcludeDrives' @()) | ForEach-Object { $_.TrimEnd('\').ToUpperInvariant() }
$excludeFolderSet = New-CIHashSet @(@(Get-Cfg 'ExcludeFolders' @())     | ForEach-Object { $_.TrimEnd('\') })
$excludeNameSet   = New-CIHashSet @(Get-Cfg 'ExcludeFolderNames' @())
$excludeExt       = New-CIHashSet @(Get-Cfg 'ExcludeExtensions' @())
$includeExt       = New-CIHashSet @(Get-Cfg 'IncludeExtensionsOnly' @())
$placeholders     = New-CIHashSet @(Get-Cfg 'PlaceholderValues' @())
$includePatterns  = @(Get-Cfg 'IncludeFilePatterns' @())
$excludePatterns  = @(Get-Cfg 'ExcludeFilePatterns' @())

$maxFileBytes  = [int64](Get-Cfg 'MaxFileSizeMB' 20) * 1MB
$maxLineLen    = [int](Get-Cfg 'MaxLineLength' 2000)
$maskSecrets   = [bool](Get-Cfg 'MaskSecrets' $true)
if ($NoMask) { $maskSecrets = $false }
$restrictAcl   = [bool](Get-Cfg 'RestrictReportAccess' $true)
$formats       = @(Get-Cfg 'ReportFormats' @('CSV', 'HTML')) | ForEach-Object { $_.ToUpperInvariant() }
$threads       = [math]::Max(1, [int](Get-Cfg 'WorkerThreads' 4))
$queueCapacity = [math]::Max(100, [int](Get-Cfg 'QueueCapacity' 5000))

$reportDir = Get-Cfg 'ReportDirectory' 'Reports'
if (-not [System.IO.Path]::IsPathRooted($reportDir)) { $reportDir = Join-Path $PSScriptRoot $reportDir }
New-Item -ItemType Directory -Path $reportDir -Force | Out-Null

# compile patterns (+ per-pattern keyword trigger)
$regexOpts = [System.Text.RegularExpressions.RegexOptions]::Compiled
$patterns = foreach ($p in @($cfg.Patterns)) {
    $grp = 0
    if ($null -ne $p.Group) { $grp = [int]$p.Group }
    $trigList = @()
    $trigRx   = $null
    if ($p.Triggers -and @($p.Triggers).Count -gt 0) {
        $trigList = @($p.Triggers)
        $trigRx = [regex]::new('(?i)(?:' + (($trigList | ForEach-Object { [regex]::Escape($_) }) -join '|') + ')', $regexOpts)
    }
    [pscustomobject]@{
        Name        = $p.Name
        Group       = $grp
        Regex       = [regex]::new($p.Regex, $regexOpts, [TimeSpan]::FromSeconds(2))
        Trigger     = $trigRx
        TriggerList = $trigList
    }
}
if (-not $patterns) { throw 'No patterns defined in config.' }

# global line gate = union of every pattern's triggers (one pass rejects most lines)
$gate = $null
if (-not ($patterns | Where-Object { -not $_.Trigger })) {
    $allTriggers = @($patterns | ForEach-Object { $_.TriggerList }) | Select-Object -Unique
    $gate = [regex]::new('(?i)(?:' + (($allTriggers | ForEach-Object { [regex]::Escape($_) }) -join '|') + ')', $regexOpts)
} else {
    Write-Warning 'Some patterns have no "Triggers" - line pre-filter disabled (slower).'
}

# ---------------------------------------------------------------- helpers (main thread)
$isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).
    IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
if (-not $isAdmin) {
    Write-Warning 'Not running as Administrator - protected folders will be skipped. Run elevated for a full scan.'
}

# Traversal prunes at an excluded folder, so an exact O(1) set lookup is enough (children are never visited).
function Test-ExcludedFolder([string]$Path) {
    $p = $Path.TrimEnd('\')
    if ($excludeFolderSet.Contains($p)) { return $true }
    $leaf = [System.IO.Path]::GetFileName($p)
    return ($leaf -and $excludeNameSet.Contains($leaf))
}

# ---------------------------------------------------------------- worker (runs in each runspace)
$worker = {
    param($Queue, $Patterns, $Gate, $Placeholders, $MaskSecrets, $MaxFileBytes, $MaxLineLen)

    function Test-IsBinary([System.IO.FileStream]$Stream) {
        $buf = New-Object byte[] 4096
        $read = $Stream.Read($buf, 0, $buf.Length)
        [void]$Stream.Seek(0, [System.IO.SeekOrigin]::Begin)
        if ($read -ge 2 -and (($buf[0] -eq 0xFF -and $buf[1] -eq 0xFE) -or ($buf[0] -eq 0xFE -and $buf[1] -eq 0xFF))) { return $false }
        return ([Array]::IndexOf($buf, [byte]0, 0, $read) -ge 0)
    }
    function Test-Placeholder([string]$Value) {
        if ([string]::IsNullOrWhiteSpace($Value)) { return $true }
        if ($Placeholders.Contains($Value)) { return $true }
        if ($Value -match '^[\$%@]' -or $Value -match '^\{\{' -or $Value -match '^\*+$' -or $Value -match '^[xX]+$') { return $true }
        return $false
    }
    function Get-MaskedValue([string]$Value) {
        if ($Value.Length -le 2) { return '*****' }
        return ('{0}***** (len {1})' -f $Value.Substring(0, 1), $Value.Length)
    }

    $res = @{
        Findings = [System.Collections.Generic.List[object]]::new()
        Scanned = 0; Bytes = [int64]0; Errors = 0
        SkipTooLarge = 0; SkipBinary = 0; SkipEmpty = 0
        Ext = @{}; Drive = @{}
    }

    foreach ($file in $Queue.GetConsumingEnumerable()) {
        $fs = $null; $sr = $null
        try {
            $info = [System.IO.FileInfo]::new($file)
            if ($info.Length -eq 0) { $res.SkipEmpty++; continue }
            if ($info.Length -gt $MaxFileBytes) { $res.SkipTooLarge++; continue }

            $fs = [System.IO.FileStream]::new($file, 'Open', 'Read', 'ReadWrite, Delete')
            if (Test-IsBinary $fs) { $res.SkipBinary++; continue }

            $sr = [System.IO.StreamReader]::new($fs, [System.Text.Encoding]::UTF8, $true, 65536)
            $res.Scanned++
            $res.Bytes += $info.Length

            $ext = [System.IO.Path]::GetExtension($file).ToLowerInvariant()
            if (-not $ext) { $ext = '(none)' }
            if (-not $res.Ext.ContainsKey($ext)) { $res.Ext[$ext] = @{ Files = 0; Bytes = [int64]0 } }
            $res.Ext[$ext].Files++; $res.Ext[$ext].Bytes += $info.Length
            $drv = $file.Substring(0, 2).ToUpperInvariant()
            if (-not $res.Drive.ContainsKey($drv)) { $res.Drive[$drv] = @{ Files = 0; Bytes = [int64]0 } }
            $res.Drive[$drv].Files++; $res.Drive[$drv].Bytes += $info.Length

            $lineNo = 0
            $seen = [System.Collections.Generic.HashSet[string]]::new()

            while ($null -ne ($line = $sr.ReadLine())) {
                $lineNo++
                if ($line.Length -lt 6) { continue }
                if ($line.Length -gt $MaxLineLen) { $line = $line.Substring(0, $MaxLineLen) }
                if ($Gate -and -not $Gate.IsMatch($line)) { continue }          # gate: most lines stop here

                foreach ($pat in $Patterns) {
                    if ($pat.Trigger -and -not $pat.Trigger.IsMatch($line)) { continue }   # per-pattern gate
                    try { $m = $pat.Regex.Match($line) } catch { continue }                 # regex timeout
                    while ($m.Success) {
                        $secret = $m.Groups[$pat.Group].Value
                        if ($pat.Group -ne 0 -and (Test-Placeholder $secret)) { $m = $m.NextMatch(); continue }

                        if ($seen.Add("$lineNo|$secret")) {
                            if ($MaskSecrets) {
                                $shown   = Get-MaskedValue $secret
                                $context = $line.Replace($secret, '*****')
                            } else {
                                $shown   = $secret
                                $context = $line
                            }
                            $context = $context.Trim()
                            if ($context.Length -gt 200) { $context = $context.Substring(0, 200) + '...' }

                            $res.Findings.Add([pscustomobject]@{
                                Server       = $env:COMPUTERNAME
                                File         = $file
                                Line         = $lineNo
                                FindingType  = $pat.Name
                                Value        = $shown
                                Context      = $context
                                LastModified = $info.LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss')
                                SizeKB       = [math]::Round($info.Length / 1KB, 1)
                            })
                        }
                        $m = $m.NextMatch()
                    }
                }
            }
        }
        catch { $res.Errors++ }
        finally {
            if ($sr) { $sr.Dispose() }
            if ($fs) { $fs.Dispose() }
        }
    }
    return $res
}

# ---------------------------------------------------------------- drive discovery
$driveTypes = @(3)
if (Get-Cfg 'IncludeNetworkDrives' $false)   { $driveTypes += 4 }
if (Get-Cfg 'IncludeRemovableDrives' $false) { $driveTypes += 2 }

$drives = Get-CimInstance -ClassName Win32_LogicalDisk |
    Where-Object { $driveTypes -contains $_.DriveType -and $excludeDrives -notcontains $_.DeviceID.ToUpperInvariant() }

if (-not $drives) { throw 'No drives to scan after applying exclusions.' }
Write-Host ('Scanning drives: {0}  |  workers: {1}' -f (($drives | ForEach-Object DeviceID) -join ', '), $threads) -ForegroundColor Cyan

# ---------------------------------------------------------------- start workers
$queue = [System.Collections.Concurrent.BlockingCollection[string]]::new($queueCapacity)   # bounded -> constant memory
$pool  = [runspacefactory]::CreateRunspacePool(1, $threads)
$pool.Open()
$jobs = for ($i = 0; $i -lt $threads; $i++) {
    $ps = [powershell]::Create()
    $ps.RunspacePool = $pool
    [void]$ps.AddScript($worker).AddArgument($queue).AddArgument($patterns).AddArgument($gate).
        AddArgument($placeholders).AddArgument($maskSecrets).AddArgument($maxFileBytes).AddArgument($maxLineLen)
    [pscustomobject]@{ PS = $ps; Handle = $ps.BeginInvoke() }
}

# ---------------------------------------------------------------- walk (producer)
$stats = @{
    Folders = 0; FoldersExcluded = 0; FilesScanned = 0; FilesSkipped = 0; Errors = 0
    BytesScanned = [int64]0
    SkipExcludedType = 0; SkipNotIncluded = 0; SkipTooLarge = 0; SkipBinary = 0; SkipEmpty = 0
}
$extStats   = @{}
$driveStats = @{}
$queued     = 0
$stack = [System.Collections.Generic.Stack[string]]::new()
foreach ($d in $drives) { $stack.Push($d.DeviceID + '\') }

try {
    while ($stack.Count -gt 0) {
        $dir = $stack.Pop()
        if (Test-ExcludedFolder $dir) { $stats.FoldersExcluded++; continue }
        $stats.Folders++

        try {
            foreach ($sd in [System.IO.Directory]::EnumerateDirectories($dir)) {
                try {
                    $attr = [System.IO.File]::GetAttributes($sd)
                    if ($attr -band [System.IO.FileAttributes]::ReparsePoint) { continue }
                    $stack.Push($sd)
                } catch { $stats.Errors++ }
            }
        } catch { $stats.Errors++ }

        try { $files = [System.IO.Directory]::EnumerateFiles($dir) } catch { $stats.Errors++; continue }

        try {
            foreach ($file in $files) {
                $ext  = [System.IO.Path]::GetExtension($file)
                $name = [System.IO.Path]::GetFileName($file)

                $skip = $excludeExt.Contains($ext)                     # O(1) set lookup
                if ($skip) { $stats.SkipExcludedType++ }
                if (-not $skip) {
                    foreach ($xp in $excludePatterns) {
                        if ($name -like $xp) { $skip = $true; $stats.SkipExcludedType++; break }
                    }
                }
                if (-not $skip -and ($includeExt.Count -gt 0 -or $includePatterns.Count -gt 0)) {
                    $matched = $includeExt.Contains($ext)
                    if (-not $matched) {
                        foreach ($ip in $includePatterns) { if ($name -like $ip) { $matched = $true; break } }
                    }
                    if (-not $matched) { $skip = $true; $stats.SkipNotIncluded++ }
                }
                if ($skip) { $stats.FilesSkipped++; continue }

                $queue.Add($file)                                      # blocks when queue is full (back-pressure)
                $queued++
                if (($queued % 5000) -eq 0) {
                    Write-Host ('  ...{0} files queued' -f $queued) -ForegroundColor DarkGray
                }
            }
        } catch { $stats.Errors++ }
    }
}
finally {
    $queue.CompleteAdding()      # always release the workers, even on error
}

# ---------------------------------------------------------------- merge worker results
$merged = [System.Collections.Generic.List[object]]::new()
foreach ($j in $jobs) {
    try {
        $out = $j.PS.EndInvoke($j.Handle)
        $r = $out | Where-Object { $_ -is [hashtable] } | Select-Object -First 1
        if ($j.PS.Streams.Error.Count -gt 0) { $stats.Errors += $j.PS.Streams.Error.Count }
        if (-not $r) { continue }
        $merged.AddRange($r.Findings)
        $stats.FilesScanned  += $r.Scanned
        $stats.BytesScanned  += $r.Bytes
        $stats.Errors        += $r.Errors
        $stats.SkipTooLarge  += $r.SkipTooLarge
        $stats.SkipBinary    += $r.SkipBinary
        $stats.SkipEmpty     += $r.SkipEmpty
        $stats.FilesSkipped  += ($r.SkipTooLarge + $r.SkipBinary + $r.SkipEmpty)
        foreach ($k in $r.Ext.Keys) {
            if (-not $extStats.ContainsKey($k)) { $extStats[$k] = @{ Files = 0; Bytes = [int64]0 } }
            $extStats[$k].Files += $r.Ext[$k].Files; $extStats[$k].Bytes += $r.Ext[$k].Bytes
        }
        foreach ($k in $r.Drive.Keys) {
            if (-not $driveStats.ContainsKey($k)) { $driveStats[$k] = @{ Files = 0; Bytes = [int64]0 } }
            $driveStats[$k].Files += $r.Drive[$k].Files; $driveStats[$k].Bytes += $r.Drive[$k].Bytes
        }
    }
    catch { $stats.Errors++ }
    finally { $j.PS.Dispose() }
}
$pool.Close(); $pool.Dispose(); $queue.Dispose()

$findings = [System.Collections.Generic.List[object]]::new([object[]]@($merged | Sort-Object File, Line))

# ---------------------------------------------------------------- reports
$stamp    = Get-Date -Format 'yyyyMMdd_HHmmss'
$baseName = Join-Path $reportDir ('PasswordScan_{0}_{1}' -f $env:COMPUTERNAME, $stamp)
$duration = (Get-Date) - $scriptStart
$outputs  = @()

# ---- statistics
$secs = [math]::Max($duration.TotalSeconds, 1)
$extFindCount = @{}; $driveFindCount = @{}; $fileFindCount = @{}; $folderFindCount = @{}
foreach ($f in $findings) {
    $e = [System.IO.Path]::GetExtension($f.File).ToLowerInvariant(); if (-not $e) { $e = '(none)' }
    $d = $f.File.Substring(0, 2).ToUpperInvariant()
    $dir = [System.IO.Path]::GetDirectoryName($f.File)
    $extFindCount[$e]       = 1 + [int]$extFindCount[$e]
    $driveFindCount[$d]     = 1 + [int]$driveFindCount[$d]
    $fileFindCount[$f.File] = 1 + [int]$fileFindCount[$f.File]
    $folderFindCount[$dir]  = 1 + [int]$folderFindCount[$dir]
}

$summary = [ordered]@{
    Server               = $env:COMPUTERNAME
    StartTime            = $scriptStart.ToString('yyyy-MM-dd HH:mm:ss')
    EndTime              = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss')
    DurationSeconds      = [math]::Round($duration.TotalSeconds, 1)
    WorkerThreads        = $threads
    DrivesScanned        = (($drives | ForEach-Object DeviceID) -join ', ')
    FoldersVisited       = $stats.Folders
    FoldersExcluded      = $stats.FoldersExcluded
    FilesScanned         = $stats.FilesScanned
    FilesSkipped         = $stats.FilesSkipped
    SkippedByExclusion   = $stats.SkipExcludedType
    SkippedNotInIncludes = $stats.SkipNotIncluded
    SkippedTooLarge      = $stats.SkipTooLarge
    SkippedBinary        = $stats.SkipBinary
    SkippedEmpty         = $stats.SkipEmpty
    AccessErrors         = $stats.Errors
    GBScanned            = [math]::Round($stats.BytesScanned / 1GB, 3)
    FilesPerSecond       = [math]::Round($stats.FilesScanned / $secs, 1)
    MBPerSecond          = [math]::Round(($stats.BytesScanned / 1MB) / $secs, 2)
    TotalFindings        = $findings.Count
    FilesWithFindings    = $fileFindCount.Count
    ValuesMasked         = $maskSecrets
}
$summaryRows = @($summary.GetEnumerator() | ForEach-Object { [pscustomobject]@{ Metric = $_.Key; Value = $_.Value } })

$byType = @($findings | Group-Object FindingType | Sort-Object Count -Descending |
    ForEach-Object { [pscustomobject]@{ Type = $_.Name; Findings = $_.Count } })
$byDrive = @($driveStats.Keys | Sort-Object | ForEach-Object {
    [pscustomobject]@{ Drive = $_; FilesScanned = $driveStats[$_].Files; MBScanned = [math]::Round($driveStats[$_].Bytes / 1MB, 1); Findings = [int]$driveFindCount[$_] }
})
$byExt = @($extStats.Keys | ForEach-Object {
    [pscustomobject]@{ Extension = $_; FilesScanned = $extStats[$_].Files; MBScanned = [math]::Round($extStats[$_].Bytes / 1MB, 1); Findings = [int]$extFindCount[$_] }
} | Sort-Object FilesScanned -Descending | Select-Object -First 20)
$topFiles = @($fileFindCount.GetEnumerator() | Sort-Object Value -Descending | Select-Object -First 10 |
    ForEach-Object { [pscustomobject]@{ File = $_.Key; Findings = $_.Value } })
$topFolders = @($folderFindCount.GetEnumerator() | Sort-Object Value -Descending | Select-Object -First 10 |
    ForEach-Object { [pscustomobject]@{ Folder = $_.Key; Findings = $_.Value } })

if ($formats -contains 'CSV') {
    $csv = "$baseName.csv"
    $findings | Export-Csv -LiteralPath $csv -NoTypeInformation -Encoding UTF8
    $outputs += $csv
}

if ($formats -contains 'HTML') {
    $enc = { param($s) [System.Net.WebUtility]::HtmlEncode([string]$s) }
    $sb = [System.Text.StringBuilder]::new()
    [void]$sb.AppendLine('<!DOCTYPE html><html><head><meta charset="utf-8"><title>Password Scan Report</title>')
    [void]$sb.AppendLine('<style>body{font-family:Segoe UI,Arial,sans-serif;margin:24px;color:#222}h1{margin-bottom:4px}')
    [void]$sb.AppendLine('table{border-collapse:collapse;width:100%;font-size:13px}th,td{border:1px solid #ccc;padding:6px 8px;text-align:left;vertical-align:top}')
    [void]$sb.AppendLine('th{background:#1f3a5f;color:#fff;position:sticky;top:0}tr:nth-child(even){background:#f5f7fa}')
    [void]$sb.AppendLine('.box{display:inline-block;margin:6px 12px 12px 0;padding:10px 16px;background:#eef2f7;border-radius:6px}')
    [void]$sb.AppendLine('code{font-family:Consolas,monospace;word-break:break-all}</style></head><body>')
    [void]$sb.AppendLine('<h1>Password Scan Report</h1>')
    [void]$sb.AppendLine(('<p>Server: <b>{0}</b> &nbsp;|&nbsp; Run: {1} &nbsp;|&nbsp; Duration: {2:hh\:mm\:ss} &nbsp;|&nbsp; Values masked: <b>{3}</b></p>' -f (& $enc $env:COMPUTERNAME), $scriptStart.ToString('yyyy-MM-dd HH:mm'), $duration, $maskSecrets))
    [void]$sb.AppendLine(('<div class="box">Findings<br><b>{0}</b></div><div class="box">Files scanned<br><b>{1}</b></div><div class="box">Files skipped<br><b>{2}</b></div><div class="box">Folders<br><b>{3}</b></div><div class="box">Access errors<br><b>{4}</b></div>' -f $findings.Count, $stats.FilesScanned, $stats.FilesSkipped, $stats.Folders, $stats.Errors))

    [void]$sb.AppendLine('<h2>By type</h2><table style="width:auto"><tr><th>Type</th><th>Count</th></tr>')
    foreach ($t in $byType) {
        [void]$sb.AppendLine(('<tr><td>{0}</td><td>{1}</td></tr>' -f (& $enc $t.Type), $t.Findings))
    }
    [void]$sb.AppendLine('</table>')
    $tbl = {
        param($title, $rows, $cols)
        [void]$sb.AppendLine("<h2>$title</h2>")
        if (-not $rows -or $rows.Count -eq 0) { [void]$sb.AppendLine('<p>None</p>'); return }
        [void]$sb.AppendLine('<table style="width:auto"><tr>' + (($cols | ForEach-Object { "<th>$_</th>" }) -join '') + '</tr>')
        foreach ($r in $rows) {
            [void]$sb.AppendLine('<tr>' + (($cols | ForEach-Object { '<td>' + (& $enc $r.$_) + '</td>' }) -join '') + '</tr>')
        }
        [void]$sb.AppendLine('</table>')
    }
    & $tbl 'Scan statistics' $summaryRows @('Metric', 'Value')
    & $tbl 'By drive' $byDrive @('Drive', 'FilesScanned', 'MBScanned', 'Findings')
    & $tbl 'By file extension (top 20 by files scanned)' $byExt @('Extension', 'FilesScanned', 'MBScanned', 'Findings')
    & $tbl 'Top 10 files by findings' $topFiles @('File', 'Findings')
    & $tbl 'Top 10 folders by findings' $topFolders @('Folder', 'Findings')
    [void]$sb.AppendLine('<h2>Details</h2><table><tr><th>File</th><th>Line</th><th>Type</th><th>Value</th><th>Context</th><th>Modified</th></tr>')
    foreach ($f in $findings) {
        [void]$sb.AppendLine(('<tr><td><code>{0}</code></td><td>{1}</td><td>{2}</td><td><code>{3}</code></td><td><code>{4}</code></td><td>{5}</td></tr>' -f
            (& $enc $f.File), $f.Line, (& $enc $f.FindingType), (& $enc $f.Value), (& $enc $f.Context), $f.LastModified))
    }
    [void]$sb.AppendLine('</table></body></html>')
    $html = "$baseName.html"
    [System.IO.File]::WriteAllText($html, $sb.ToString(), [System.Text.UTF8Encoding]::new($false))
    $outputs += $html
}

# statistics file (JSON) for this run
$statsFile = "$baseName.stats.json"
[ordered]@{
    Summary     = $summary
    ByType      = $byType
    ByDrive     = $byDrive
    ByExtension = $byExt
    TopFiles    = $topFiles
    TopFolders  = $topFolders
} | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath $statsFile -Encoding UTF8
$outputs += $statsFile

# running history of every scan (one row per run, kept across runs)
$historyFile = Join-Path $reportDir 'ScanHistory.csv'
try { [pscustomobject]$summary | Export-Csv -LiteralPath $historyFile -Append -NoTypeInformation -Encoding UTF8 }
catch { Write-Warning "Could not append to ScanHistory.csv: $($_.Exception.Message)" }
if (Test-Path -LiteralPath $historyFile) { $outputs += $historyFile }

# lock reports down to Administrators + SYSTEM
if ($restrictAcl) {
    foreach ($o in $outputs) {
        try { & icacls.exe $o /inheritance:r /grant:r '*S-1-5-32-544:F' '*S-1-5-18:F' | Out-Null } catch { }
    }
}

Write-Host ''
Write-Host ('Done in {0:hh\:mm\:ss}. Findings: {1} | Files scanned: {2} | Skipped: {3} | Access errors: {4}' -f $duration, $findings.Count, $stats.FilesScanned, $stats.FilesSkipped, $stats.Errors) -ForegroundColor Green
$outputs | ForEach-Object { Write-Host "Report: $_" -ForegroundColor Green }
